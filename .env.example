# ----------------------------------------------------------------------------
# Trove configuration. Copy this file to ".env" and fill in the values.
# Never commit your real .env — it contains secrets.
# ----------------------------------------------------------------------------

# --- Discord (required) ---
# Create an application + bot at https://discord.com/developers/applications
# "Bot" tab -> Token; "General Information" -> Application ID.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: a server (guild) ID for instant slash-command registration during development.
# Leave empty in production to register commands globally (can take up to ~1 hour to appear).
DEV_GUILD_ID=

# --- Data providers (at least one recommended; all have free tiers) ---
# Alchemy:  https://dashboard.alchemy.com/
# Moralis:  https://admin.moralis.io/   (best DeFi-position coverage)
# Covalent: https://goldrush.dev/        (widest chain list)
ALCHEMY_KEY=
MORALIS_KEY=
COVALENT_KEY=

# Optional: TRON works keyless via TronGrid's public endpoint; a free key lifts the rate limit.
# Get one at https://developers.tron.network — sent as the TRON-PRO-API-KEY header.
TRONGRID_KEY=

# Ethereum mainnet RPC URL — used to resolve ENS names (e.g. vitalik.eth).
# Any public or private mainnet endpoint works.
MAINNET_RPC_URL=

# --- Behaviour (optional, sensible defaults) ---
# Comma-separated default chains queried by /wallet. Any chain in the registry works; a chain is
# served by whichever configured provider covers it (with automatic fail-over between them).
DEFAULT_CHAINS=ethereum,base,arbitrum,optimism,polygon,bnb,avalanche

# Where watchlists are stored (a small JSON file). Mount as a Docker volume to persist across restarts.
DATA_DIR=./data

# How long (seconds) a wallet result is cached before a refresh re-fetches.
CACHE_TTL_SECONDS=90

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# development | production | test
NODE_ENV=development
